# Powerlevel10k 即时提示符必须靠近文件开头。
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
export NVM_DIR="$HOME/.nvm"
# 个人 Python 工具链默认使用 /usr/local 的 CPython 3.13（仅在本机存在时生效）；
# VS Code/项目显式注入 UV_PYTHON 时保留项目解释器。
if [[ -z "$UV_PYTHON" && -x /usr/local/bin/python3.13 ]]; then
  export UV_PYTHON=/usr/local/bin/python3.13
fi

typeset -U path PATH
# 只放确实存在的目录；atuin 若经官方脚本装在 ~/.atuin/bin，PATH 与 init 归属
# ~/.zshrc.local 机器差异层（本机未装 atuin，Ctrl+R 现实形态是 fzf，见下文守卫）。
path=(
  "$HOME/.local/bin"
  "$HOME/.opencode/bin"
  $path
)
export PATH

ZSH_THEME="powerlevel10k/powerlevel10k"
zstyle ':omz:update' mode disabled
zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' lazy-cmd eslint prettier pnpm yarn codex
plugins=(git sudo extract colored-man-pages nvm)

# P10k 负责 OSC 133 提示符边界，避免再叠加一套 PS1 包装。
if [[ $TERM_PROGRAM == WezTerm || ${HERDR_ENV:-} == 1 ]]; then
  typeset -g POWERLEVEL9K_TERM_SHELL_INTEGRATION=true
fi
# 无控制终端的交互调用（agent 工具跑 zsh -i -c）永远画不出提示符：关掉 gitstatus，
# 既不白拉起守护进程，启动失败时也不会把「gitstatus failed to initialize」横幅
# 打进工具输出（$TTY 为空 = 无控制终端，与 gx/config/terminal.zsh 的守卫同源）。
if [[ -z ${TTY:-} ]]; then
  typeset -g POWERLEVEL9K_DISABLE_GITSTATUS=true
fi
source "$ZSH/oh-my-zsh.sh"

# 常用命令与 Ubuntu 默认 Bash 对齐；仅影响交互式 zsh。
# 无匹配的通配符原样传给命令，允许 pip 包名[extra]、URL 的 ? 和 rm -f *.tmp。
unsetopt NOMATCH NULL_GLOB CSH_NULL_GLOB
# echo 仅在显式 -e 时解释转义；重复重定向只写入最后一个目标。
setopt BSD_ECHO
unsetopt MULTIOS
# cd 不隐式操作目录栈，pushd 的 +/- 方向与 Bash 一致；后台任务不自动降优先级。
unsetopt AUTO_CD AUTO_PUSHD PUSHD_MINUS BG_NICE
# 空命令行的 Ctrl+D 恢复退出；下面的 widget 保留非空行上的删除行为。
unsetopt IGNORE_EOF
# Oh My Zsh 默认让 grep 跳过版本库与虚拟环境目录，会导致递归搜索漏项。
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'

# 历史文件仍作为可移植回退；交互检索默认由 fzf（Ctrl+R）与前缀搜索提供，
# 装了 atuin 的机器上 Ctrl+R 由 atuin 接管（见后文守卫段）。
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
unsetopt HIST_VERIFY

# 原生菜单补全：Tab 打开候选，上下左右选择，模糊匹配大小写与分隔符。
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{blue}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}没有匹配：%d%f'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' matcher-list \
  '' \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=** r:|=**'

bindkey -e

# 按 Bash 的单词边界移动；Ctrl+W 单独按空白分词，便于一次删除完整路径。
autoload -Uz select-word-style
select-word-style bash
autoload -Uz backward-kill-word-match
zle -N backward-kill-space-word backward-kill-word-match
zstyle ':zle:backward-kill-space-word*' word-style space

ubuntu_delete_char_or_eof() {
  if [[ -z $BUFFER ]]; then
    zle .delete-char-or-list
  else
    zle .delete-char
  fi
}
zle -N ubuntu_delete_char_or_eof

# 覆盖普通、应用光标及兼容序列，匹配 Ubuntu 的 Readline 常用按键。
for keymap in emacs viins; do
  bindkey -M "$keymap" '^U' backward-kill-line
  bindkey -M "$keymap" '^W' backward-kill-space-word
  bindkey -M "$keymap" '^D' ubuntu_delete_char_or_eof
  bindkey -M "$keymap" '^Q' quoted-insert
  bindkey -M "$keymap" '^[[2~' quoted-insert
  for keyseq in '^[[H' '^[OH' '^[[1~' '^[[7~'; do
    bindkey -M "$keymap" "$keyseq" beginning-of-line
  done
  for keyseq in '^[[F' '^[OF' '^[[4~' '^[[8~'; do
    bindkey -M "$keymap" "$keyseq" end-of-line
  done
  for keyseq in '^[f' '^[[1;5C' '^[[5C' '^[^[[C' '^[[1;3C'; do
    bindkey -M "$keymap" "$keyseq" forward-word
  done
  for keyseq in '^[b' '^[[1;5D' '^[[5D' '^[^[[D' '^[[1;3D'; do
    bindkey -M "$keymap" "$keyseq" backward-word
  done
done
unset keymap keyseq

# herdr 的 prefix 是 ctrl+b：pane 内的 zsh 想发 ^B（backward-char）需双击 prefix
# 透传（ctrl+b ctrl+b；help 默认在 prefix+?）。补 Alt+Ctrl+B 作单键直达——该组合
# 在 zsh emacs/viins、WezTerm（GX-10 迁移后）与 herdr 默认键位三侧均无占用；
# 逐字符左移也可以直接用左方向键。
for keymap in emacs viins; do
  bindkey -M "$keymap" '^[^B' backward-char
done
unset keymap

# fzf 负责文件和目录选择；其 key-bindings 把 Ctrl+R 绑到 fzf 历史检索，
# 装了 atuin 的机器上稍后由 atuin 覆盖。
[[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
[[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
# 选项按 fzf 版本探测拼装：--border=rounded/--pointer/--marker 自 0.24 起才存在，
# Ubuntu 20.04 的 0.20.0 退化为 --border；fzf 缺失时不导出。探测时清空
# FZF_DEFAULT_OPTS，否则继承的旧选项会让 --version 自身报错。
if (( $+commands[fzf] )); then
  autoload -Uz is-at-least
  # 取首行首字段（"0.44.1 (d0466fa)" → 0.44.1）；单行输出下 ${(f)..}[1] 会退化为
  # 标量取首字符，故分两步截断。
  _gx_fzf_version="$(FZF_DEFAULT_OPTS= command fzf --version 2>/dev/null)"
  _gx_fzf_version=${_gx_fzf_version%%$'\n'*}
  _gx_fzf_version=${_gx_fzf_version%% *}
  # 首字段必须是 <数字>.<数字> 形态；包装脚本打印 "fzf 0.20.0" 或 "v0.44.1" 时
  # is-at-least 会把非数字当成新版，故解析不出一律退化为 0（走老选项，安全一侧）。
  [[ $_gx_fzf_version == <->.<->* ]] || _gx_fzf_version=0
  _gx_fzf_opts="--height=55% --layout=reverse --info=inline --prompt='❯ ' --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8,border:#6c7086"
  if is-at-least 0.24 "$_gx_fzf_version"; then
    _gx_fzf_opts+=" --border=rounded --pointer='▶' --marker='✓'"
  else
    _gx_fzf_opts+=" --border"
  fi
  export FZF_DEFAULT_OPTS=$_gx_fzf_opts
  # 文件枚举优先 fd（Ubuntu 包名为 fdfind），其次 rg --files；都没有就用 fzf 默认 find。
  if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f'
  elif (( $+commands[fdfind] )); then
    export FZF_DEFAULT_COMMAND='fdfind --type f'
  elif (( $+commands[rg] )); then
    export FZF_DEFAULT_COMMAND='rg --files'
  fi
  unset _gx_fzf_version _gx_fzf_opts
fi

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# 输入前缀后按上下键，只遍历以该前缀开头的历史；连续按键保持原始前缀。
# 本块承接 wezterm 安装器曾追加到 ~/.zshrc 的「# >>> wezterm-gx >>>」cursor-mode
# 键位块（~/.zshrc 归 gx 层真源；gx 部署时历史标记块随 .zshrc 整体替换剥离）。
# 位置约束：必须在全部 zle -N/bindkey（含上方 fzf 源内绑定）之后、autosuggestions
# 与 syntax-highlighting 的 source 之前。
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
zstyle ':zle:up-line-or-beginning-search' leave-cursor yes
zstyle ':zle:down-line-or-beginning-search' leave-cursor yes

# WezTerm 在普通/应用光标模式下会发送两组不同序列，两组都显式覆盖。
for keymap in emacs viins; do
  bindkey -M "$keymap" '^[[A' up-line-or-beginning-search
  bindkey -M "$keymap" '^[OA' up-line-or-beginning-search
  bindkey -M "$keymap" '^[[B' down-line-or-beginning-search
  bindkey -M "$keymap" '^[OB' down-line-or-beginning-search
done
bindkey -M emacs '^P' up-line-or-beginning-search
bindkey -M emacs '^N' down-line-or-beginning-search

# 灰色历史建议先加载，Atuin 随后注册其历史策略。
if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086,italic'
  # 插件在首个 precmd 才统一包裹全部 widget（届时本文件含后面的 zle -N/bindkey 已
  # 执行完），本开关只去掉此后每个提示符的整体重绑（真 PTY 实测 5.5 ms → 0.05 ms）。
  # 代价：首个提示符之后再 zle -N 的新 widget 不会被包裹——~/.zshrc.local 里的
  # zle -N 仍在本文件 source 阶段内执行，不受影响。
  ZSH_AUTOSUGGEST_MANUAL_REBIND=1
  # 超过该长度的命令行放弃取建议（每击键按整个 buffer 查历史），越界时灰色建议直接
  # 消失（插件在取建议前就 unset POSTDISPLAY）。它是补足项、不是主因：4401 字符的
  # 粘贴行 20 键中位实测 —— 两项都不设 25.5 ms，只设本项 24.5 ms（≈无效），
  # 只设下方 ZSH_HIGHLIGHT_MAXLENGTH 1.0 ms，两者同设 0.65 ms。
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=512
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# atuin 未装则整段跳过（本机即如此，Ctrl+R 留在 fzf）；装了只接管 Ctrl+R，
# 普通上下键保留给 Zsh 的前缀历史搜索（上方 cursor-mode 块）。
if (( $+commands[atuin] )); then
  eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
fi

# 高亮插件必须最后加载，才能观察前面定义的全部 widget。
if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  # 每击键重新解析整个 buffer 是长行卡顿的主因：4401 字符行 20 键中位实测
  # 25.5 ms → 1.0 ms、粘贴首帧从「40 s 内仍未静默」降到 1.5 s。
  # 注意越界后的真实形态不是「没有颜色」：z-sy-h 在 `region_highlight=()` **之前**
  # 就 return，于是越界前那一帧的高亮区间原样留在 region_highlight 里，并随后续编辑
  # 被 ZLE 平移/拉伸——颜色停在旧的解析结果上，可能与当前文本不符（例如行首插入一个
  # 不存在的命令，它仍显示成「有效命令」的绿色）。这是有意接受的降级：超长行只保证
  # 可编辑，不保证配色正确。512 以内实测 <3 ms/击键，绝大多数真实长命令仍正常高亮。
  ZSH_HIGHLIGHT_MAXLENGTH=512
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# 本机专属配置（CUDA/SDK 等机器差异项放这里，不进 gx/config）。
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# kimi-code
export PATH="$HOME/.kimi-code/bin:$PATH"
kimi() {
  PI_HARDWARE_CURSOR=1 command kimi "$@"
}

# Go 1.26.5 (安装于 ~/.local/go)
export PATH="$HOME/.local/go/bin:$HOME/go/bin:$PATH"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# OSC 7 仅在交互终端和目录变化时发送；独立模块保留用户主题与插件。
[[ -r "$ZSH/gx/config/terminal.zsh" ]] && source "$ZSH/gx/config/terminal.zsh"
