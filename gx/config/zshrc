if (( ${+GX_PACKAGE_ROOT} || ${+GX_PROFILE_DIR} )); then
  if [[ ${GX_PACKAGE_ROOT:-} != /* || ${GX_PROFILE_DIR:-} != /* || \
        ! -r "$GX_PACKAGE_ROOT/gx/config/package.zsh" ]]; then
    print -u2 -- 'gx package: valid GX_PACKAGE_ROOT and GX_PROFILE_DIR are both required'
    return 1
  fi
  source "$GX_PACKAGE_ROOT/gx/config/package.zsh" || return 1
fi

# Powerlevel10k 即时提示符必须靠近文件开头；包模式先确定独立缓存根。
if [[ -n ${TTY:-} && -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# install.sh 依赖此行的 export ZSH= 形态改写自定义安装路径。
export ZSH="$HOME/.oh-my-zsh"
if [[ -n ${GX_PACKAGE_ROOT:-} ]]; then
  export ZSH="$GX_PACKAGE_ROOT"
else
  export NVM_DIR="$HOME/.nvm"
fi
# 个人 Python 工具链默认使用 /usr/local 的 CPython 3.13（仅在本机存在时生效）；
# VS Code/项目显式注入 UV_PYTHON 时保留项目解释器，包模式使用 launcher 的工具链。
if [[ -z ${GX_PACKAGE_ROOT:-} && -z "$UV_PYTHON" && -x /usr/local/bin/python3.13 ]]; then
  export UV_PYTHON=/usr/local/bin/python3.13
fi

typeset -U path PATH
if [[ -n ${GX_PACKAGE_ROOT:-} ]]; then
  # 包工具优先；保留用户可执行工具目录，不 source 其机器配置或改写登录状态。
  # windows.zsh 在 PowerShell 安装器退出后再调用一次，新装的命令不必重开终端。
  _gx_add_user_bins() {
    local dir
    for dir in "$HOME/.local/bin" "$HOME/.opencode/bin" "$HOME/.kimi-code/bin" \
               "$HOME/.local/go/bin" "$HOME/go/bin" "$HOME/.cargo/bin" \
               "${BUN_INSTALL:-$HOME/.bun}/bin"; do
      [[ -d $dir && -x $dir ]] && path+=("$dir")
    done
    return 0
  }
  _gx_add_user_bins
else
  path=(
    "$HOME/.local/bin"
    "$HOME/.opencode/bin"
    $path
  )
fi
export PATH

# 外部程序生成的初始化脚本缓存在 $ZSH_CACHE_DIR：首行记录生成命令、二进制路径/mtime/大小与
# GX 包身份，全部一致时直接 source 已 zcompile 的缓存，省掉每次启动的进程（Windows 上各约 50 ms）。
# 文件名带首行的 FNV-1a 短哈希：键不同的并发 shell 各写各的文件，脚本和 .zwc 不会来自不同的键。
# 用法：_gx_init_cache 名称 二进制 生成命令 [附加键...] && eval "$REPLY"；缓存写不进去时
# REPLY 就是生成的脚本本身。
_gx_init_cache() {
  emulate -L zsh
  local dir=${ZSH_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh} stamp output file tmp stale char
  local -A info
  local -i hash=2166136261
  if ! { zmodload -F zsh/stat b:zstat && zstat -H info -- $2 } 2>/dev/null; then
    REPLY=$(eval $3 2>/dev/null) && [[ -n $REPLY ]]
    return
  fi
  stamp="#gx-init v2 ${(j: :)${(q)@[2,-1]}} $info[mtime] $info[size] ${(q)_gx_package_id}"
  # 算术里的 #name 只取变量的首字符，必须先把首行拆成单个字符再逐个取码。
  for char in ${(s::)stamp}; do
    (( hash = ((hash ^ #char) * 16777619) & 0xffffffff ))
  done
  file=$dir/gx-init-$1-${(l:8::0:)$(( [##16] hash ))}.zsh
  if [[ -r $file ]]; then
    output=$(<$file)
    if [[ ${output%%$'\n'*} == "$stamp" ]]; then
      REPLY="builtin source ${(q)file}"
      return 0
    fi
  fi
  output=$(eval $3 2>/dev/null) && [[ -n $output ]] || return 1
  REPLY=$output
  zmodload -F zsh/files b:zf_mv b:zf_rm 2>/dev/null || return 0
  tmp=$file.$$.tmp
  if { print -r -- "$stamp"$'\n'"$output" >| $tmp } 2>/dev/null && zf_rm -f -- $file.zwc &&
     zf_mv -f -- $tmp $file; then
    REPLY="builtin source ${(q)file}"
    zcompile -UR -- $tmp.zwc $file 2>/dev/null && zf_mv -f -- $tmp.zwc $file.zwc
    # 换键留下的旧文件超过一天才清理，不删并发 shell 刚校验过、正要 source 的那份；只认 8 位哈希，
    # 不会误删名称以本名称开头的其他缓存（如 fzf 与 fzf-zsh）。
    for stale in $dir/gx-init-$1-????????.zsh(N.mh+24); do
      [[ $stale == "$file" ]] || zf_rm -f -- $stale $stale.zwc
    done
  fi
  zf_rm -f -- $tmp $tmp.zwc 2>/dev/null
  return 0
}
_gx_package_id=
if [[ -n ${GX_PACKAGE_ROOT:-} && -r $GX_PACKAGE_ROOT/package-origin.json ]]; then
  _gx_package_id=$(<$GX_PACKAGE_ROOT/package-origin.json)
fi

ZSH_THEME="powerlevel10k/powerlevel10k"
zstyle ':omz:update' mode disabled
zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' lazy-cmd eslint prettier pnpm yarn codex
plugins=(git sudo extract colored-man-pages nvm herdr)
# Windows 的 sudo 是系统 sudo.exe，提不了 MSYS 命令的权限；没有 man 时也不包装它。
[[ $OSTYPE == (cygwin|msys)* ]] && plugins=(${plugins:#sudo})
[[ -f ${commands[man]:-} ]] || plugins=(${plugins:#colored-man-pages})

# P10k 负责 OSC 133 提示符边界，避免再叠加一套 PS1 包装；Ghostty 自带的 zsh 集成已在
# .zshenv 阶段加载（_ghostty_state 已定义）时由它发 OSC 133，P10k 不再重复。
if [[ $TERM_PROGRAM == ghostty || ${HERDR_ENV:-} == 1 ]] && (( ! ${+_ghostty_state} )); then
  typeset -g POWERLEVEL9K_TERM_SHELL_INTEGRATION=true
fi
# 无控制终端时只加载 OMZ/插件和参数配置，不初始化主题或缓存中的 gitstatus 预加载。
if [[ -z ${TTY:-} ]]; then
  ZSH_THEME=""
  typeset -g POWERLEVEL9K_DISABLE_GITSTATUS=true
fi
if [[ -n ${GX_PACKAGE_ROOT:-} && $OSTYPE == (cygwin|msys)* ]]; then
  # MSYS 上没有 SSH 登录后切换用户的场景：无 SSH 变量时预置 p10k 的判定，省掉 `who -m`。
  if [[ -n ${TTY:-} && -z ${SSH_CLIENT:-}${SSH_TTY:-}${SSH_CONNECTION:-} ]]; then
    typeset -gix P9K_SSH=0
    typeset -gx _P9K_SSH_TTY=$TTY
  fi
  # OMZ 在 LS_COLORS 为空时每次都 fork dircolors；预置缓存的结果后它直接跳过。
  if [[ -z ${LS_COLORS:-} && ! -f $HOME/.dircolors ]] && (( $+commands[dircolors] )) &&
     _gx_init_cache dircolors "$commands[dircolors]" 'command dircolors -b' "${TERM-}" "${COLORTERM-}"; then
    eval "$REPLY"
  fi
fi
source "$ZSH/oh-my-zsh.sh"

# 大段粘贴一次字面插入，避免逐字符重放插件；短粘贴保留默认 self-* 语义。
zstyle -e ':bracketed-paste-magic' active-widgets '
  if (( ${#PASTED} > 512 )); then reply=(); else reply=("self-*"); fi
'

# 常用命令与 Ubuntu 默认 Bash 对齐；仅影响交互式 zsh。
# 无匹配的通配符原样传给命令，允许 pip 包名[extra]、URL 的 ? 和 rm -f *.tmp。
unsetopt NOMATCH NULL_GLOB CSH_NULL_GLOB
# echo 仅在显式 -e 时解释转义；重复重定向只写入最后一个目标。
setopt BSD_ECHO
unsetopt MULTIOS
# cd 不隐式操作目录栈，pushd 的 +/- 方向与 Bash 一致；后台任务不自动降优先级。
unsetopt AUTO_CD AUTO_PUSHD PUSHD_MINUS BG_NICE
# 空命令行的 Ctrl+D 恢复退出；下面的 widget 保留非空行上的删除行为。
unsetopt IGNORE_EOF
# Oh My Zsh 默认让 grep 跳过版本库与虚拟环境目录，会导致递归搜索漏项。
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'

# 历史文件仍作为可移植回退；交互检索默认由 fzf（Ctrl+R）与前缀搜索提供，
# 装了 atuin 的机器上 Ctrl+R 由 atuin 接管（见后文守卫段）。
HISTFILE="${GX_PROFILE_DIR:-$HOME}/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
unsetopt HIST_VERIFY

# 原生菜单补全：Tab 打开候选，上下左右选择，模糊匹配大小写与分隔符。
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{blue}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}没有匹配：%d%f'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' matcher-list \
  '' \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=** r:|=**'

bindkey -e

# 按 Bash 的单词边界移动；Ctrl+W 单独按空白分词，便于一次删除完整路径。
autoload -Uz select-word-style
select-word-style bash
autoload -Uz backward-kill-word-match
zle -N backward-kill-space-word backward-kill-word-match
zstyle ':zle:backward-kill-space-word*' word-style space

ubuntu_delete_char_or_eof() {
  if [[ -z $BUFFER ]]; then
    zle .delete-char-or-list
  else
    zle .delete-char
  fi
}
zle -N ubuntu_delete_char_or_eof

# 覆盖普通、应用光标及兼容序列，匹配 Ubuntu 的 Readline 常用按键。
for keymap in emacs viins; do
  bindkey -M "$keymap" '^U' backward-kill-line
  bindkey -M "$keymap" '^W' backward-kill-space-word
  bindkey -M "$keymap" '^D' ubuntu_delete_char_or_eof
  bindkey -M "$keymap" '^Q' quoted-insert
  bindkey -M "$keymap" '^[[2~' quoted-insert
  for keyseq in '^[[H' '^[OH' '^[[1~' '^[[7~'; do
    bindkey -M "$keymap" "$keyseq" beginning-of-line
  done
  for keyseq in '^[[F' '^[OF' '^[[4~' '^[[8~'; do
    bindkey -M "$keymap" "$keyseq" end-of-line
  done
  for keyseq in '^[f' '^[[1;5C' '^[[5C' '^[^[[C' '^[[1;3C'; do
    bindkey -M "$keymap" "$keyseq" forward-word
  done
  for keyseq in '^[b' '^[[1;5D' '^[[5D' '^[^[[D' '^[[1;3D'; do
    bindkey -M "$keymap" "$keyseq" backward-word
  done
done
unset keymap keyseq

# herdr 的 prefix 是 ctrl+b：pane 内的 zsh 想发 ^B（backward-char）需双击 prefix
# 透传（ctrl+b ctrl+b；help 默认在 prefix+?）。补 Alt+Ctrl+B 作单键直达——该组合
# 在 zsh emacs/viins、Ghostty GX 与 herdr 的默认键位里均无占用；逐字符左移也可以
# 直接用左方向键。Ghostty GX 默认解绑上游用于切换标签的 alt+1..8，Alt+数字照常
# 作为 readline 风格的 digit-argument 交给 zsh。
for keymap in emacs viins; do
  bindkey -M "$keymap" '^[^B' backward-char
done
unset keymap

# fzf 负责文件和目录选择及 Ctrl+R；装了 atuin 的机器上稍后由 atuin 接管 Ctrl+R。
# 0.48+（含 Windows 官方版）自带 --zsh；旧版保留 Linux doc/share 的脚本路径。
if (( $+commands[fzf] )); then
  autoload -Uz is-at-least
  # 清空继承的选项，避免旧选项让版本探测自身失败；只取首行首字段。
  _gx_fzf_version=0
  if _gx_init_cache fzf-version "$commands[fzf]" \
       'v=$(FZF_DEFAULT_OPTS= command fzf --version) && print -r -- "_gx_fzf_version=${(q)v}"'; then
    eval "$REPLY"
  fi
  _gx_fzf_version=${_gx_fzf_version%%$'\n'*}
  _gx_fzf_version=${_gx_fzf_version%% *}
  [[ $_gx_fzf_version == <->.<->* ]] || _gx_fzf_version=0
  # completion.zsh 也安装 Tab widget 并恢复全部选项；无 ZLE 时两种脚本都不安全。
  if [[ -n ${TTY:-} && -o zle ]]; then
    if is-at-least 0.48 "$_gx_fzf_version" &&
       _gx_init_cache fzf-zsh "$commands[fzf]" 'FZF_DEFAULT_OPTS= command fzf --zsh'; then
      eval "$REPLY"
    else
      if [[ -r /usr/share/doc/fzf/examples/completion.zsh ]]; then
        source /usr/share/doc/fzf/examples/completion.zsh
      fi
      if [[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
        source /usr/share/doc/fzf/examples/key-bindings.zsh
      else
        for _gx_fzf_dir in /usr/share/fzf /usr/share/fzf/shell "${commands[fzf]:A:h:h}/share/fzf"; do
          [[ -r "$_gx_fzf_dir/completion.zsh" ]] && source "$_gx_fzf_dir/completion.zsh"
          if [[ -r "$_gx_fzf_dir/key-bindings.zsh" ]]; then
            source "$_gx_fzf_dir/key-bindings.zsh"
            break
          fi
        done
      fi
    fi
  fi
  # 0.24 起支持 rounded/pointer/marker；Ubuntu 20.04 的 0.20.0 只用 --border。
  _gx_fzf_opts="--height=55% --layout=reverse --info=inline --prompt='❯ ' --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8,border:#6c7086"
  if is-at-least 0.24 "$_gx_fzf_version"; then
    _gx_fzf_opts+=" --border=rounded --pointer='▶' --marker='✓'"
  else
    _gx_fzf_opts+=" --border"
  fi
  export FZF_DEFAULT_OPTS=$_gx_fzf_opts
  # 文件枚举优先 fd（Ubuntu 包名为 fdfind），其次 rg --files；都没有就用 fzf 默认 find。
  if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f'
  elif (( $+commands[fdfind] )); then
    export FZF_DEFAULT_COMMAND='fdfind --type f'
  elif (( $+commands[rg] )); then
    export FZF_DEFAULT_COMMAND='rg --files'
  fi
  unset _gx_fzf_version _gx_fzf_opts _gx_fzf_dir
fi

# zoxide 把 _ZO_ECHO/_ZO_RESOLVE_SYMLINKS 写进生成的脚本，一并作为缓存键。
if (( $+commands[zoxide] )) &&
   _gx_init_cache zoxide "$commands[zoxide]" 'command zoxide init zsh' "${_ZO_ECHO-}" "${_ZO_RESOLVE_SYMLINKS-}"; then
  eval "$REPLY"
fi
unset -f _gx_init_cache
unset _gx_package_id

# 输入前缀后按上下键，只遍历以该前缀开头的历史；连续按键保持原始前缀。
# 本块承接旧版 WezTerm GX 安装器曾追加到 ~/.zshrc 的「# >>> wezterm-gx >>>」
# cursor-mode 键位块（~/.zshrc 归 gx 层真源；gx 部署时历史标记块随 .zshrc 整体替换剥离）。
# 位置约束：必须在全部 zle -N/bindkey（含上方 fzf 源内绑定）之后、autosuggestions
# 与 syntax-highlighting 的 source 之前。
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
zstyle ':zle:up-line-or-beginning-search' leave-cursor yes
zstyle ':zle:down-line-or-beginning-search' leave-cursor yes

# 终端在普通/应用光标模式（DECCKM）下为方向键发送两组不同序列，两组都显式覆盖。
for keymap in emacs viins; do
  bindkey -M "$keymap" '^[[A' up-line-or-beginning-search
  bindkey -M "$keymap" '^[OA' up-line-or-beginning-search
  bindkey -M "$keymap" '^[[B' down-line-or-beginning-search
  bindkey -M "$keymap" '^[OB' down-line-or-beginning-search
done
bindkey -M emacs '^P' up-line-or-beginning-search
bindkey -M emacs '^N' down-line-or-beginning-search

# Windows（MSYS/Cygwin）专属：irm/iwr/iex 转交 PowerShell、缺失命令提示与 open/pbcopy 等常用 shim。
[[ -r "$ZSH/gx/config/windows.zsh" ]] && source "$ZSH/gx/config/windows.zsh"

# 灰色历史建议先加载，Atuin 随后注册其历史策略。
if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086,italic'
  # 插件在首个 precmd 才统一包裹全部 widget（届时本文件含后面的 zle -N/bindkey 已
  # 执行完），本开关只去掉此后每个提示符的整体重绑（真 PTY 实测 5.5 ms → 0.05 ms）。
  # 代价：首个提示符之后再 zle -N 的新 widget 不会被包裹——~/.zshrc.local 里的
  # zle -N 仍在本文件 source 阶段内执行，不受影响。
  ZSH_AUTOSUGGEST_MANUAL_REBIND=1
  # 超过该长度的命令行放弃取建议（每击键按整个 buffer 查历史），越界时灰色建议直接
  # 消失（插件在取建议前就 unset POSTDISPLAY）。它是补足项、不是主因：4401 字符的
  # 粘贴行 20 键中位实测 —— 两项都不设 25.5 ms，只设本项 24.5 ms（≈无效），
  # 只设下方 ZSH_HIGHLIGHT_MAXLENGTH 1.0 ms，两者同设 0.65 ms。
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=512
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  # 插件在 zsh ≥ 5.0.8 上自动开异步模式，每击键经进程替换 fork 一个子 shell 取建议；MSYS/Cygwin
  # 的 fork 很贵（Windows 实测每次约 30 ms，整行输入时 ZLE 明显卡顿），改为进程内同步查历史。
  [[ $OSTYPE == (cygwin|msys)* ]] && unset ZSH_AUTOSUGGEST_USE_ASYNC
fi

# atuin 未装则整段跳过（本机即如此，Ctrl+R 留在 fzf）；装了只接管 Ctrl+R，
# 普通上下键保留给 Zsh 的前缀历史搜索（上方 cursor-mode 块）。
if (( $+commands[atuin] )); then
  eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
fi

# 高亮插件必须最后加载，才能观察前面定义的全部 widget。
if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  # 每击键重新解析整个 buffer 是长行卡顿的主因：4401 字符行 20 键中位实测
  # 25.5 ms → 1.0 ms、粘贴首帧从「40 s 内仍未静默」降到 1.5 s。
  # 注意越界后的真实形态不是「没有颜色」：z-sy-h 在 `region_highlight=()` **之前**
  # 就 return，于是越界前那一帧的高亮区间原样留在 region_highlight 里，并随后续编辑
  # 被 ZLE 平移/拉伸——颜色停在旧的解析结果上，可能与当前文本不符（例如行首插入一个
  # 不存在的命令，它仍显示成「有效命令」的绿色）。这是有意接受的降级：超长行只保证
  # 可编辑，不保证配色正确。512 以内实测 <3 ms/击键，绝大多数真实长命令仍正常高亮。
  ZSH_HIGHLIGHT_MAXLENGTH=512
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

if [[ -r "${GX_PROFILE_DIR:-$HOME}/.p10k.zsh" ]]; then
  source "${GX_PROFILE_DIR:-$HOME}/.p10k.zsh"
elif [[ -n ${GX_PACKAGE_ROOT:-} ]]; then
  source "$GX_PACKAGE_ROOT/gx/config/p10k.zsh"
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# 本机专属配置；包模式只读取独立 profile，不加载宿主 HOME 的机器层。
[[ -r "${GX_PROFILE_DIR:-$HOME}/.zshrc.local" ]] && source "${GX_PROFILE_DIR:-$HOME}/.zshrc.local"

kimi() {
  PI_HARDWARE_CURSOR=1 command kimi "$@"
}

if [[ -z ${GX_PACKAGE_ROOT:-} ]]; then
  export PATH="$HOME/.kimi-code/bin:$PATH"
