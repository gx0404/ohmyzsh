{
  "schema": 1,
  "project": {
    "name": "ohmyzsh",
    "source_roots": [
      "lib",
      "plugins",
      "templates",
      "themes",
      "tools"
    ],
    "test_roots": [
      "tests",
      "lib/tests"
    ],
    "reviewed": true,
    "sharing": "shared"
  },
  "evidence_root": ".playwright-mcp",
  "version_targets": [],
  "ci": [
    "lint",
    "test",
    "generated-check"
  ],
  "commands": {
    "setup": {
      "status": "configured",
      "argv": ["bash", "scripts/setup_env.sh", "--print"],
      "cwd": "."
    },
    "dev": {
      "status": "configured",
      "argv": ["bash", "scripts/dev_shell.sh"],
      "cwd": "."
    },
    "build": {
      "status": "not-applicable",
      "reason": "核心 shell 框架解释执行；发行用原生启动器在 package 阶段编译，无独立核心 build 目标"
    },
    "lint": {
      "status": "configured",
      "argv": ["bash", "scripts/check_syntax.sh"],
      "cwd": "."
    },
    "typecheck": {
      "status": "configured",
      "argv": ["python3", "tests/gx_launcher.py"],
      "cwd": "."
    },
    "test": {
      "status": "configured",
      "argv": ["bash", "scripts/run_tests.sh"],
      "cwd": "."
    },
    "test-integration": {
      "status": "configured",
      "argv": ["zsh", "tests/smoke_load.zsh", "--plugins", "git,docker"],
      "cwd": "."
    },
    "test-heavy": {
      "status": "configured",
      "argv": ["python3", "scripts/gx_lifecycle_entry.py"],
      "cwd": "."
    },
    "generated-check": {
      "status": "configured",
      "argv": ["python3", "scripts/build_agent_kb.py", "--check"],
      "cwd": "."
    },
    "ui-smoke": {
      "status": "configured",
      "argv": ["bash", "scripts/ui_smoke.sh"],
      "cwd": "."
    },
    "graph": {
      "status": "configured",
      "argv": ["bash", "scripts/graphify.sh", "build"],
      "cwd": "."
    },
    "graph-check": {
      "status": "configured",
      "argv": ["bash", "scripts/graphify.sh", "check"],
      "cwd": "."
    },
    "kb": {
      "status": "configured",
      "argv": ["python3", "scripts/build_agent_kb.py", "--confirm"],
      "cwd": "."
    },
    "kb-check": {
      "status": "configured",
      "argv": ["python3", "scripts/build_agent_kb.py", "--check"],
      "cwd": "."
    },
    "package": {
      "status": "configured",
      "argv": ["python3", "scripts/gx_package_entry.py"],
      "cwd": "."
    },
    "package-test": {
      "status": "configured",
      "argv": ["python3", "tests/run_package_tests.py"],
      "cwd": "."
    },
    "gx-install": {
      "status": "configured",
      "argv": ["sh", "gx/install.sh"],
      "cwd": "."
    },
    "gx-bundle": {
      "status": "configured",
      "argv": ["sh", "gx/bundle.sh"],
      "cwd": "."
    }
  }
}
